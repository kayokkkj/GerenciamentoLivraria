@model LivroModel

<div class="container mt-5">
    <div class="card shadow-sm border-0" style="border-radius: 12px;">
       
        <div class="card-header bg-dark text-white p-3 d-flex justify-content-between align-items-center"
             style="border-radius: 12px 12px 0 0; background-color: #1f2937 !important;">
            <h5 class="mb-0 fw-bold">Informações Detalhadas</h5>
            <span class="badge bg-secondary opacity-75">ID: @Model.Id</span>
        </div>

        <div class="card-body p-4">
            <div class="row">
               
                <div class="col-md-4 mb-4 mb-md-0">
                   <div class="d-flex align-items-center justify-content-center text-muted"
                         style="height: 100%; min-height: 350px; background-color: #f9fafb; border: 2px dashed #e5e7eb; border-radius: 8px;">
                        <div class="text-center">
                            <i class="bi bi-book text-secondary" style="font-size: 3rem;"></i>
                            <p class="small mt-2">Capa indisponível</p>
                        </div>
                    </div>
                </div>

               
                <div class="col-md-8">
                    <h2 class="fw-bold text-dark mb-1">Livro: @Model.Nome</h2>
                    <p class="text-muted mb-4">Escrito por <span class="fw-bold text-dark">@Model.Autor</span></p>

                    <div class="mb-4">
                        <h6 class="text-uppercase text-muted fw-bold small" style="letter-spacing: 1px;">Descrição</h6>
                        <p class="text-secondary" style="line-height: 1.6;">@Model.Descricao</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-6 col-md-4">
                            <div class="p-3 border-0 rounded" style="background-color: #f9fafb;">
                                <h6 class="text-muted small fw-bold mb-1">Preço</h6>
                                <span class="h5 fw-bold text-dark">@Model.Preco.ToString()</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 border-0 rounded" style="background-color: #f9fafb;">
                                <h6 class="text-muted small fw-bold mb-1">Estoque</h6>
                                <span class="h5 fw-bold @(Model.Estoque > 0 ? "text-dark" : "text-danger")">
                                    @Model.Estoque un.
                                </span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <div class="p-3 border-0 rounded" style="background-color: #f9fafb;">
                                <h6 class="text-muted small fw-bold mb-1">Categoria</h6>
                                <div><span class="badge bg-light text-dark border">@Model.Categoria</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

       
        <div class="card-footer bg-white p-3 border-top-0 d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4" style="border-radius: 8px;">
                Voltar
            </a>
            <a asp-action="EditarLivro" asp-route-id="@Model.Id" class="btn btn-dark-custom px-4">
                Editar Livro
            </a>
        </div>
    </div>
</div>

<style>
    
    body {
        background-color: #f3f4f6;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .btn-dark-custom {
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s;
    }

        .btn-dark-custom:hover {
            background: #374151;
            transform: translateY(-1px);
            color: white;
        }

    h2, h5 {
        letter-spacing: -0.5px;
    }
</style>