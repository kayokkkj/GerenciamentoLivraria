@model List<LivroModel>


<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Livros Cadastrados</h2>
            <p class="text-muted small">Gerencie o catálogo da sua livraria</p>
        </div>
        <a asp-action="CriarLivro" class="btn btn-dark-custom shadow-sm">
            <i class="bi bi-plus-lg"></i> Novo Livro
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4" style="background-color: white; border-radius: 12px;">
        <div class="row g-4 align-items-end">

            <div class="col-12 col-md-5">
                <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2">Buscar por titulo ou autor</label>
                        <input type="text" name="buscar" value="@ViewData["buscarlivro"]" class="form-control custom-input" placeholder="Título ou autor..." />
                    </div>
                    <button type="submit" class="btn btn-dark-custom py-2 px-3">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </form>
            </div>

           

            <div class="col-12 col-md-6">
                <form asp-action="Index" method="get" class="d-flex gap-2 align-items-end justify-content-md-end">
                    <div class="flex-grow-1" style="max-width: 140px;">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2">Preço Mín.</label>
                        <input type="number" name="precominimo" value="@ViewData["precoMinimoP"]" step="0.01" class="form-control custom-input" placeholder="0,00" />
                    </div>

                    <div class="flex-grow-1" style="max-width: 140px;">
                        <label class="form-label text-muted small fw-bold text-uppercase mb-2">Preço Máx.</label>
                        <input type="number" name="precomaximo" value="@ViewData["precoMaximoP"]" step="0.01" class="form-control custom-input" placeholder="99,00" />
                    </div>

                    <button type="submit" class="btn btn-dark-custom py-2 px-3">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </form>
            </div>

        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="background-color: white;">
                    <thead style="background-color: #f9fafb;">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-muted small fw-bold">Título</th>
                            <th class="py-3 text-uppercase text-muted small fw-bold">Autor</th>
                            <th class="py-3 text-uppercase text-muted small fw-bold text-center">Categoria</th>
                            <th class="py-3 text-uppercase text-muted small fw-bold">Preço</th>
                            <th class="py-3 text-uppercase text-muted small fw-bold text-center">Estoque</th>
                            <th class="py-3 text-uppercase text-muted small fw-bold text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var livro in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="fw-bold text-dark">@livro.Nome</span>
                                </td>
                                <td>@livro.Autor</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@livro.Categoria</span>
                                </td>
                                <td class="fw-bold">@livro.Preco.ToString()</td>
                                <td class="text-center">
                                    @if (livro.Estoque < 5)
                                    {
                                        <span class="text-danger fw-bold">@livro.Estoque</span>
                                    }
                                    else
                                    {
                                        <span>@livro.Estoque</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group" role="group">
                                        <a asp-action="DetalhesLivro" asp-route-id="@livro.Id"
                                           class="btn btn-sm btn-outline-secondary border-0" title="Ver Detalhes">
                                            Detalhes
                                        </a>
                                        <a asp-action="editarLivro" asp-route-id="@livro.Id"
                                           class="btn btn-sm btn-outline-secondary border-0" title="Editar">
                                            Editar
                                        </a>
                                        <a asp-action="ExcluirLivro" asp-route-id="@livro.Id"
                                           class="btn btn-sm btn-outline-danger border-0" title="Excluir">
                                            Excluir
                                        </a>
                                    </div>
                                </td>
                            </tr>                    
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 border rounded bg-light">
            <p class="text-muted">Nenhum livro cadastrado ainda.</p>
            <a asp-action="CriarLivro" class="btn btn-dark-custom">Cadastrar Novo Livro</a>
        </div>
    }
</div>

<style>
    body {
        background-color: #f3f4f6;
    }
   

    .btn-dark-custom {
        background: #1f2937;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s;
    }

        .btn-dark-custom:hover {
            background: #374151;
            transform: translateY(-1px);
            color: white;
        }

   
    .table thead th {
        border-bottom: 1px solid #e5e7eb;
    }

    .table tbody tr:hover {
        background-color: #f9fafb;
    }
</style>