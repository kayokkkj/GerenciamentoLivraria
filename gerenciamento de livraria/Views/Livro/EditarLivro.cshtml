@model LivroModel

<div class="container py-5">

    <div class="mx-auto" style="max-width: 600px;">

        <div class="bg-white shadow-lg rounded-4 p-5">

            <h2 class="text-center mb-4">Editar Livro</h2>

            <form asp-action="EditarLivro" method="post" class="d-flex flex-column gap-3">

                <input type="hidden" asp-for="Id" />

                <div>
                    <label asp-for="Nome"></label>
                    <input asp-for="Nome" class="form-control" placeholder="Nome do livro" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Autor"></label>
                    <input asp-for="Autor" class="form-control" placeholder="Autor" />
                    <span asp-validation-for="Autor" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Descricao"></label>
                    <input asp-for="Descricao" class="form-control" placeholder="Descrição do livro" />
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Categoria"></label>
                    <select asp-for="Categoria" class="form-control">
                        <option value="">Selecione uma categoria</option>
                        <option>Ficção Científica</option>
                        <option>Romance</option>
                        <option>Fantasia</option>
                        <option>Didático</option>
                        <option>Suspense</option>
                    </select>
                    <span asp-validation-for="Categoria" class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="Preco"></label>
                    <input asp-for="Preco" class="form-control" placeholder="R$" />

                </div>

                <div>
                    <label asp-for="Estoque"></label>
                    <input asp-for="Estoque" class="form-control" placeholder="Estoque disponível" />

                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-dark w-100">
                        Salvar alteracoes
                    </button>

                    <a asp-controller="Livro" asp-action="Index" class="btn btn-outline-secondary w-100">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>




